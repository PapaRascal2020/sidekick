{
    "name": "paparascaldev/sidekick",
    "description": "A fluent Laravel package for integrating with OpenAI, Anthropic Claude, Mistral, and Cohere AI services",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "autoload": {
        "files": [
            "src/Helpers/Sidekick.php"
        ],
        "psr-4": {
            "PapaRascalDev\\Sidekick\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PapaRascalDev\\Sidekick\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Ashley Johnson"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "laravel/framework": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "PapaRascalDev\\Sidekick\\SidekickServiceProvider"
            ],
            "aliases": {
                "Sidekick": "PapaRascalDev\\Sidekick\\Facades\\Sidekick"
            }
        }
    },
    "config": {
        "sort-packages": true
    }
}
